# URL base de la API XLR8. Variables que empiezan con EXPO_PUBLIC_ se incrustan
# en el bundle del cliente, no van secretos aquí.
#
# - Web / iOS Simulator: http://localhost:3000
# - Android Emulator: usa http://10.0.2.2:3000 (alias del localhost de tu máquina)
# - Dispositivo físico (Expo Go / dev build): usa la IP LAN de tu máquina,
#   por ejemplo http://192.168.1.50:3000 (debe estar en la misma red Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
